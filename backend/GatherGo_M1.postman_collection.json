{
	"info": {
		"_postman_id": "4b6c8a2d-1234-5678-90ab-cdef12345678",
		"name": "GatherGo M1 — Official API",
		"description": "Complete Milestone 1 (Auth & Profiles) collection for the GatherGo Mobile App. Organized by screen flow.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Signup & Verification Flow",
			"item": [
				{
					"name": "A. Register Account",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"phone\": \"+919876543210\",\n    \"password\": \"GatherGo123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/signup",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"signup"
							]
						},
						"description": "First step of the app. User enters email, phone, and password. Backend sends a 6-digit OTP to the email."
					},
					"response": []
				},
				{
					"name": "B. Verify OTP",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"otp\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-email",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"verify-email"
							]
						},
						"description": "User enters the 6-digit code from their email. On success, this returns the 'accessToken' and 'refreshToken' which must be stored in Secure Storage."
					},
					"response": []
				},
				{
					"name": "C. Upload Profile Photo",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "photo",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/users/photo",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users",
								"photo"
							]
						},
						"description": "After verification, ask user to pick a photo. Uploads to S3 and returns a CloudFront URL."
					},
					"response": []
				},
				{
					"name": "D. Save Profile Details",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullName\": \"Vansh Ahuja\",\n    \"dob\": \"2000-01-01\",\n    \"gender\": \"male\",\n    \"country\": \"India\",\n    \"bio\": \"Traveler @ heart\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/users/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users",
								"profile"
							]
						},
						"description": "Final step of profile setup. Saves details to the database and marks user as ready for home screen."
					},
					"response": []
				},
				{
					"name": "Resend OTP",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"purpose\": \"email-verification\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/resend-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"resend-otp"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Login & Social Login Flow",
			"item": [
				{
					"name": "Login (Email/Pass)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"GatherGo123!\",\n    \"deviceToken\": \"fcm_device_token\",\n    \"platform\": \"ios\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Standard login for existing users. Stores deviceToken in AWS SNS automatically."
					},
					"response": []
				},
				{
					"name": "Google Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"idToken\": \"google_id_token_from_client\",\n    \"deviceToken\": \"fcm_device_token\",\n    \"platform\": \"android\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/google",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"google"
							]
						}
					},
					"response": []
				},
				{
					"name": "Facebook Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"accessToken\": \"fb_access_token_from_client\",\n    \"deviceToken\": \"fcm_device_token\",\n    \"platform\": \"ios\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/facebook",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"facebook"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. User & Session",
			"item": [
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"me"
							]
						},
						"description": "Used in Splash Screen or App Initialization to check if user is verified and has a completed profile."
					},
					"response": []
				},
				{
					"name": "Refresh Token Rotation",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						}
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Account Recovery",
			"item": [
				{
					"name": "Forgot Password (OTP Request)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/forgot-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"forgot-password"
							]
						}
					},
					"response": []
				},
				{
					"name": "Reset Password (With OTP)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"otp\": \"123456\",\n    \"password\": \"NewStrongPassword123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/reset-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"reset-password"
							]
						}
					},
					"response": []
				}
			]
		}
	],
