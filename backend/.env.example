# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=1010101010
JWT_REFRESH_SECRET=1010101010

# ─── AWS General ──────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── AWS RDS (PostgreSQL) ────────────────────────────
AWS_RDS_HOST=your-rds-instance.region.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DB=gathergo
AWS_RDS_USER=postgres
AWS_RDS_PASSWORD=your_rds_password

# ─── AWS S3 ──────────────────────────────────────────
AWS_S3_BUCKET=gathergo-uploads
AWS_CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# ─── AWS SES ─────────────────────────────────────────
AWS_SES_FROM_EMAIL=vanshahuja318@gmail.com
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Reply-to / support address shown in all transactional email footers.
# Falls back to AWS_SES_FROM_EMAIL when unset.
SUPPORT_EMAIL=support@gatherrgo.com

# ─── Brevo (transactional email) ─────────────────────
# Provider toggle is in src/config/emailProvider.js (not env).
# Brevo → SMTP & API → API keys → Create (must start with xkeysib-, NOT xsmtpsib- SMTP keys)
BREVO_API_KEY=
BREVO_FROM_EMAIL=Hello@GatherrGo.com
BREVO_FROM_NAME=Gatherrgo

# ─── Firebase / FCM v1 (Push Notifications) ──────────
# 1. Go to Firebase Console → Project gatherrgo → Project Settings → Service Accounts
# 2. Click "Generate new private key" → download the JSON file
# 3. Place it in backend/ (e.g. backend/firebase-service-account.json) — already gitignored
# 4. Set path below (relative to backend/ or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
FIREBASE_PROJECT_ID=gatherrgo


# ─── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.gatherrgo.com/auth/email/google/callback
# Drive OAuth — add this exact URI under Authorized redirect URIs (same OAuth Web client as Gmail)
# and add https://www.googleapis.com/auth/drive.readonly scope in Google Cloud Console → Data Access
GOOGLE_DRIVE_REDIRECT_URI=https://api.gatherrgo.com/auth/drive/callback

# ─── Google Places (Legacy) — location autocomplete proxy (/places/autocomplete) ─
# GCP project gatherrgo → APIs & Services → Credentials. Restrict the key to
# "Places API" (places-backend.googleapis.com). Server-side only, never ship it in the app.
GOOGLE_PLACES_API_KEY=
PLACES_AUTOCOMPLETE_RATE_LIMIT_PER_MINUTE=60

# ─── Microsoft / Outlook OAuth ───────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.gatherrgo.com/auth/email/microsoft/callback
MICROSOFT_TENANT_ID=common

# ─── Token Encryption (AES-256-GCM) ──────────────────
# Must be exactly 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ─── Facebook OAuth ──────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ─── App URLs ────────────────────────────────────────
CLIENT_URL=http://localhost:3001
# Public website URL — used as logo fallback when CloudFront is not configured.
# logo.png must be present in frontend/public/ and deployed to this origin.
WEBSITE_URL=https://www.gatherrgo.com
PASSWORD_RESET_URL=http://localhost:3001/reset-password
APP_DEEP_LINK_BASE_URL=https://gatherrgo.com

# ─── Invite & App Store Links (M4 — Friend & Invite System) ─
# Controls share text and install-link fallback
# false = dev (APK/TestFlight links), true = production (store links)
APP_IS_LIVE=false

# Dev install links (used when APP_IS_LIVE=false)
ANDROID_APK_URL=https://s3.amazonaws.com/gathergo-releases/gathergo-latest.apk
IOS_TESTFLIGHT_URL=https://testflight.apple.com/join/TESTFLIGHT_CODE

# Production store links (used when APP_IS_LIVE=true)
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.gathergo.app
IOS_STORE_URL=https://apps.apple.com/app/gathergo/idAPP_ID

# Invite base URL (invite links are built as {APP_DEEP_LINK_BASE_URL}/invite/{type}/{token})
APP_INVITE_BASE_URL=https://gatherrgo.com/invite

# OG image for link previews (WhatsApp card, iMessage card)
OG_INVITE_IMAGE_URL=https://cdn.gatherrgo.com/og-invite-card.png

# Universal Links / App Links verification files
APP_BUNDLE_ID=com.gathergo.app
APP_TEAM_ID=XXXXXXXXXX
ANDROID_SHA256_CERT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# Rate limiting (M4)
FRIEND_INVITE_RATE_LIMIT_PER_HOUR=10
FRIEND_REQUEST_RATE_LIMIT_PER_DAY=20

# Swee AI — per-user chat limits (POST /ai/chat only)
SWEE_CHAT_RATE_LIMIT_PER_HOUR=30
SWEE_CHAT_RATE_LIMIT_PER_DAY=200
# Circuit breaker: open after N Gemini 429/503 failures in window
SWEE_CIRCUIT_FAILURE_THRESHOLD=5
SWEE_CIRCUIT_FAILURE_WINDOW_MS=60000
SWEE_CIRCUIT_COOLDOWN_MS=90000
# Metrics alert when error rate exceeds threshold in rolling window
SWEE_METRICS_WINDOW_MS=900000
SWEE_ALERT_ERROR_RATE=0.05
SWEE_ALERT_MIN_REQUESTS=10

# Upload limits — restart server after changes; app reads GET /config/upload-limits
UPLOAD_PHOTO_MAX_MB=15
UPLOAD_VIDEO_MAX_MB=200
UPLOAD_VIDEO_MAX_COUNT=2
UPLOAD_DOC_MAX_MB=15
UPLOAD_DOC_MAX_COUNT=50
UPLOAD_DOC_MAX_BATCH=10
UPLOAD_PHOTO_MAX_BATCH=20
UPLOAD_ACTIVITY_PHOTO_MAX_COUNT=5
UPLOAD_ACTIVITY_PHOTO_MAX_BATCH=5
UPLOAD_TRIP_CREATE_PHOTO_BATCH=10
UPLOAD_TRIP_CREATE_DOC_BATCH=10
UPLOAD_AVATAR_MAX_MB=10
UPLOAD_PROMO_VIDEO_MAX_MB=500
UPLOAD_BLOG_IMAGE_MAX_MB=10

# Google Gemini (Swee AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
