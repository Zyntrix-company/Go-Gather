# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=1010101010
JWT_REFRESH_SECRET=1010101010

# ─── AWS General ──────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── AWS RDS (PostgreSQL) ────────────────────────────
AWS_RDS_HOST=your-rds-instance.region.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DB=gathergo
AWS_RDS_USER=postgres
AWS_RDS_PASSWORD=your_rds_password

# ─── AWS S3 ──────────────────────────────────────────
AWS_S3_BUCKET=gathergo-uploads
AWS_CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# ─── AWS SES ─────────────────────────────────────────
AWS_SES_FROM_EMAIL=vanshahuja318@gmail.com
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=  

# ─── AWS SNS (Push Notifications) ────────────────────
AWS_SNS_PLATFORM_APP_ARN_IOS=arn:aws:sns:region:account-id:app/APNS/gathergo-ios
AWS_SNS_PLATFORM_APP_ARN_ANDROID=arn:aws:sns:region:account-id:app/GCM/gathergo-android

# ─── FCM (Push Notifications) ────────────────────────
FCM_SERVER_KEY=your_fcm_legacy_server_key


# ─── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.gathergo.app/auth/email/google/callback

# ─── Microsoft / Outlook OAuth ───────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.gathergo.app/auth/email/microsoft/callback
MICROSOFT_TENANT_ID=common

# ─── Token Encryption (AES-256-GCM) ──────────────────
# Must be exactly 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ─── Facebook OAuth ──────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ─── App URLs ────────────────────────────────────────
CLIENT_URL=http://localhost:3001
PASSWORD_RESET_URL=http://localhost:3001/reset-password
APP_DEEP_LINK_BASE_URL=https://gathergo.app

# ─── Branch.io (M4 — Friend & Invite System) ─────────
BRANCH_KEY=key_live_xxxx
BRANCH_SECRET=secret_xxxx

# Controls share text and Branch fallback URLs
# false = dev (APK/TestFlight links), true = production (store links)
APP_IS_LIVE=false

# Dev install links (used when APP_IS_LIVE=false)
ANDROID_APK_URL=https://s3.amazonaws.com/gathergo-releases/gathergo-latest.apk
IOS_TESTFLIGHT_URL=https://testflight.apple.com/join/TESTFLIGHT_CODE

# Production store links (used when APP_IS_LIVE=true)
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.gathergo
IOS_STORE_URL=https://apps.apple.com/app/gathergo/idAPP_ID

# Invite base URL (used in Branch payload + plain fallback)
APP_INVITE_BASE_URL=https://gathergo.app/invite

# OG image for link previews (WhatsApp card, iMessage card)
OG_INVITE_IMAGE_URL=https://cdn.gathergo.app/og-invite-card.png

# Universal Links / App Links verification files
APP_BUNDLE_ID=com.gathergo
APP_TEAM_ID=XXXXXXXXXX
ANDROID_SHA256_CERT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# Rate limiting (M4)
FRIEND_INVITE_RATE_LIMIT_PER_HOUR=10
FRIEND_REQUEST_RATE_LIMIT_PER_DAY=20
